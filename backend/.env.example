PROJECT_NAME=RAG Agent KB System
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

DATABASE_URL=sqlite:///E:/rag_project/rag-agent-kb-system/data/app.db
UPLOAD_DIR=E:/rag_project/rag-agent-kb-system/data/uploads
CHROMA_DIR=E:/rag_project/rag-agent-kb-system/data/chroma
CHROMA_COLLECTION_NAME=knowledge_chunks
LOG_DIR=E:/rag_project/rag-agent-kb-system/data/logs
LOG_LEVEL=INFO

FIRST_SUPERUSER_USERNAME=admin
FIRST_SUPERUSER_PASSWORD=admin123456

EMBEDDING_MODEL_NAME=E:/rag_project/rag-agent-kb-system/data/models/embeddings/bge-m3
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=16
RERANKER_MODEL_NAME=E:/rag_project/rag-agent-kb-system/data/models/rerankers/bge-reranker-v2-m3
RERANKER_ENABLED=true
RERANKER_DEVICE=auto
RERANKER_CANDIDATE_TOP_K=32
CHUNK_SIZE=800
CHUNK_OVERLAP=120
MAX_UPLOAD_SIZE_MB=50
ALLOWED_FILE_EXTENSIONS=[".txt",".md",".markdown",".pdf",".doc",".docx",".ppt",".pptx",".xls",".xlsx"]

OPENAI_API_KEY=your_api_key
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL_NAME=deepseek-v4-flash

# Optional ingestion preprocessing. Keep disabled until API key/OCR dependencies are ready.
PREPROCESS_LLM_ENABLED=false
PREPROCESS_LLM_TARGET_CHUNK_TYPES=["table_row_fact"]
PREPROCESS_LLM_MAX_INPUT_CHARS=4000
PREPROCESS_LLM_TIMEOUT_SECONDS=60
PREPROCESS_LOCAL_BAD_PAGE_OCR_ENABLED=true
PREPROCESS_DROP_BAD_TEXT_LAYER_WHEN_OCR_AVAILABLE=true
PREPROCESS_TEXT_REPAIR_ENABLED=true
CHUNK_QUALITY_ENABLED=true
CHUNK_LLM_NORMALIZATION_ENABLED=true
CHUNK_LLM_MIN_QUALITY_SCORE=0.82
CHUNK_LLM_MIN_CHUNKS_PER_DOCUMENT=20
CHUNK_LLM_MAX_CHUNKS_PER_DOCUMENT=120
CHUNK_LLM_CANDIDATE_RATIO=0.3
CHUNK_LLM_SKIP_ALREADY_NORMALIZED_SOURCES=true
CHUNK_LLM_MERGE_MODE=replace_source
CHUNK_LLM_MIN_INPUT_CHARS=20
INGESTION_AGENT_ENABLED=true
INGESTION_AGENT_LLM_ENABLED=false
INGESTION_AGENT_SAMPLE_PAGES=3
INGESTION_EXECUTOR=pipeline
INGESTION_MAX_CONCURRENT_JOBS=1
RELEASE_GPU_CACHE_AFTER_INGESTION=true

# LiteParse is the fallback parser for legacy Office, image-heavy Office,
# or native Office parser failures. DOC/PPT/XLS require LibreOffice on PATH.
LITEPARSE_ENABLED=true
LITEPARSE_COMMAND=lit
LITEPARSE_TIMEOUT_SECONDS=180
LITEPARSE_OCR_ENABLED=true
LITEPARSE_OCR_LANGUAGE=chi_sim
LITEPARSE_MAX_PAGES=1000
LITEPARSE_DPI=180
LITEPARSE_NUM_WORKERS=2

PREPROCESS_OCR_FALLBACK_ENABLED=false
OCR_MIN_EXTRACTED_CHARS=50
OCR_MAX_PAGES=
PDF_REJECT_GARBLED_TEXT=true

RAG_TOP_K=6
RAG_CONTEXT_MAX_CHARS=8000
RAG_MIN_SCORE=0.35
RAG_MIN_READABLE_CHARS=30
RAG_MAX_GARBLED_TOKEN_RATIO=0.08
RAG_PRESERVE_PRE_RERANK_TOP_K=3
RAG_MAX_RETURNED_HITS=8
RAG_TRACE_TOP_HITS=12
QUERY_AGENT_ENABLED=true
QUERY_AGENT_LLM_ENABLED=false
QUERY_AGENT_MAX_QUERIES=3
QUERY_AGENT_MAX_SUB_QUESTIONS=3
QUERY_DECOMPOSITION_ENABLED=true
QUERY_DECOMPOSITION_PER_QUERY_TOP_K=16
QUERY_DECOMPOSITION_SCORE_FACTOR=0.96
QUERY_DECOMPOSITION_MAX_CANDIDATES=48
QUERY_AGENT_EVIDENCE_JUDGE_ENABLED=true
QUERY_AGENT_EVIDENCE_LLM_ENABLED=false
HYBRID_RETRIEVAL_ENABLED=true
HYBRID_KEYWORD_CANDIDATE_TOP_K=32
HYBRID_KEYWORD_MAX_CHUNKS=5000
HYBRID_BM25_ENABLED=true
HYBRID_BM25_CANDIDATE_TOP_K=32
HYBRID_BM25_MAX_CHUNKS=5000
HYBRID_BM25_K1=1.5
HYBRID_BM25_B=0.75
HYBRID_VECTOR_WEIGHT=0.62
HYBRID_KEYWORD_WEIGHT=0.08
HYBRID_BM25_WEIGHT=0.30
HYBRID_LEXICAL_ONLY_MAX_SCORE=0.82

OCR_DETECTION_MODEL_DIR=E:/rag_project/rag-agent-kb-system/data/models/ocr/paddleocr/PP-OCRv5_mobile_det
OCR_RECOGNITION_MODEL_DIR=E:/rag_project/rag-agent-kb-system/data/models/ocr/paddleocr/PP-OCRv5_mobile_rec
OCR_TEXTLINE_ORIENTATION_MODEL_DIR=E:/rag_project/rag-agent-kb-system/data/models/ocr/paddleocr/PP-LCNet_x0_25_textline_ori
PADDLEOCR_DEVICE=cpu
PADDLEOCR_USE_TEXTLINE_ORIENTATION=false
PADDLEOCR_USE_SUBPROCESS=true
